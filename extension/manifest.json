{
  "manifest_version": 3,
  "name": "Focusr Companion",
  "version": "1.1.0",
  "description": "Allowed workspaces companion for Focusr to monitor legitimate work tabs and desktop apps to eliminate false distraction penalties.",
  "permissions": [
    "tabs",
    "history",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
